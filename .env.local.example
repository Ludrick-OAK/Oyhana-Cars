# Console Appwrite > votre projet > Overview (endpoint = "API Endpoint")
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=votre-project-id

# Console Appwrite > votre projet > Overview > Integrations > API keys
# Créez une clé avec TOUS les scopes des sections "Databases" (databases, collections,
# attributes, indexes, documents), "Users" et "Storage" (buckets, files).
# Ne jamais exposer cette clé au navigateur (elle n'est utilisée que côté serveur).
APPWRITE_API_KEY=votre-api-key

# Optionnel : URL publique de ton app, utilisée dans le lien de réinitialisation
# de mot de passe envoyé par email. Si absente, elle est déduite automatiquement
# de la requête (fonctionne en local et sur Vercel, mais mets-la si tu as un
# domaine personnalisé pour plus de fiabilité).
NEXT_PUBLIC_APP_URL=https://oyhana-cars.vercel.app

# Utilisé uniquement en local par scripts/seed-ds3.ts
SEED_USER_EMAIL=ton-email@exemple.com
